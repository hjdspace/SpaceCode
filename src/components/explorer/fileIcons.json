{
  "prefix": "vscode-icons",
  "default": "file-type-text",
  "names": {
    "package.json": "file-type-npm",
    "package-lock.json": "file-type-npm",
    "pnpm-lock.yaml": "file-type-pnpm",
    "yarn.lock": "file-type-yarn",
    "bun.lockb": "file-type-bun",
    "bun.lock": "file-type-bun",
    "composer.json": "file-type-php",
    "composer.lock": "file-type-php",
    "cargo.toml": "file-type-rust",
    "cargo.lock": "file-type-rust",
    "go.mod": "file-type-go",
    "go.sum": "file-type-go",
    "gemfile": "file-type-ruby",
    "gemfile.lock": "file-type-ruby",
    "requirements.txt": "file-type-python",
    "pyproject.toml": "file-type-python",
    "cmakelists.txt": "file-type-cmake"
  },
  "patterns": [
    ["tsconfig", "file-type-tsconfig"],
    ["jsconfig", "file-type-jsconfig"],
    ["vitest.config", "file-type-vitest"],
    ["vite.config", "file-type-vite"],
    ["webpack.", "file-type-webpack"],
    ["rollup.config", "file-type-rollup"],
    ["babel.config", "file-type-babel"],
    ["tailwind.config", "file-type-tailwind"],
    ["postcss.config", "file-type-postcss"],
    ["eslint", "file-type-eslint"],
    ["prettier", "file-type-prettier"],
    ["editorconfig", "file-type-editorconfig"],
    ["dockerfile", "file-type-docker"],
    ["docker-compose", "file-type-docker2"],
    ["makefile", "file-type-makefile"],
    [".env", "file-type-dotenv"],
    ["gitignore", "file-type-git"],
    ["gitattributes", "file-type-git"],
    ["gitmodules", "file-type-git"],
    ["license", "file-type-license"],
    ["licence", "file-type-license"],
    ["changelog", "file-type-markdown"],
    ["readme", "file-type-markdown"],
    [".test.", "file-type-test"],
    [".spec.", "file-type-test"]
  ],
  "extensions": {
    "ts": "file-type-typescript",
    "mts": "file-type-typescript",
    "cts": "file-type-typescript",
    "tsx": "file-type-reactts",
