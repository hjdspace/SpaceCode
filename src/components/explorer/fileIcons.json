    "mdx": "file-type-mdx",
    "txt": "file-type-text",
    "json": "file-type-json",
    "jsonc": "file-type-json",
    "json5": "file-type-json5",
    "yaml": "file-type-yaml",
    "yml": "file-type-yaml",
