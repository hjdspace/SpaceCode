{
  "name": "spacecode",
  "version": "0.8.10",
  "homepage": "https://github.com/hjdspace/SpaceCode",
  "author": {
    "name": "hjdspace",
    "email": "hjdspace1990@gmail.com"
  },
  "description": "SpaceCode - AI Agent Desktop Application (Electron + Vue 3)",
  "main": "dist-electron/main.js",
  "scripts": {
    "engine:install": "cd engine && bun install --backend=hardlink && node ../scripts/repair-workspace-links.cjs",
    "engine:build:desktop": "node scripts/build-engine-desktop.cjs",
    "postinstall": "npm run patch:node-pty && npm run patch:dev-electron && npm run engine:install",
    "patch:node-pty": "node scripts/patch-node-pty.cjs",
    "patch:dev-electron": "node scripts/patch-dev-electron-icon.cjs",
    "copy-bun": "node scripts/copy-bun.cjs",
    "download:officecli": "node scripts/download-officecli.mjs",
    "predev": "npm run patch:dev-electron",
    "dev": "vite",
    "clean:electron": "node scripts/clean-dist-electron.cjs",
    "build": "vue-tsc --noEmit && vite build",
    "check:performance": "node scripts/check-build-performance.cjs",
    "build:proxy": "node -e \"const esbuild=require('esbuild');esbuild.buildSync({entryPoints:['electron/proxy/index.ts'],bundle:true,outdir:'dist-electron/proxy',platform:'node',format:'cjs',external:['electron']})\"",
    "build:linux-pty": "node scripts/build-linux-pty.mjs",
    "build:all": "npm run build && npm run build:proxy",
    "preview": "vite preview",
    "preelectron:dev": "npm run patch:dev-electron",
    "electron:dev": "vite",
    "icons:generate": "node icons/generate-icons.cjs && node icons/generate-ico.cjs",
    "icons:generate:ico": "node icons/generate-ico.cjs",
    "gen:file-icons": "node scripts/generate-file-icons.mjs",
    "electron:build": "npm run icons:generate && npm run copy-bun && npm run prebuild:cua-driver && npm run prebuild:officecli && npm run engine:build:desktop && npm run clean:electron && npm run build:all && electron-builder",
    "electron:build:win": "npm run icons:generate && npm run copy-bun && npm run prebuild:cua-driver && npm run prebuild:officecli && npm run engine:build:desktop && npm run clean:electron && npm run build:all && electron-builder --win",
    "electron:build:mac": "npm run icons:generate && npm run copy-bun && npm run prebuild:cua-driver && npm run prebuild:officecli && npm run engine:build:desktop && npm run clean:electron && npm run build:all && electron-builder --mac",
    "electron:build:linux": "npm run icons:generate && npm run copy-bun && npm run prebuild:cua-driver && npm run prebuild:officecli && npm run engine:build:desktop && npm run clean:electron && npm run build:all && npm run patch:node-pty && npm run build:linux-pty && electron-builder --linux",
    "electron:build:local": "node scripts/electron-build-local.cjs",
    "electron:build:win:local": "node scripts/electron-build-local.cjs --win",
    "electron:build:mac:local": "node scripts/electron-build-local.cjs --mac",
    "electron:build:linux:local": "node scripts/electron-build-local.cjs --linux",
    "prebuild:cua-driver": "node scripts/download-cua-driver.mjs",
    "prebuild:officecli": "node scripts/download-officecli.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "changelog:all": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "version": "npm run changelog && git add CHANGELOG.md",
    "postversion": "git push && git push --tags"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@electron/rebuild": "^4.2.0",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/vue": "^0.1.7",
    "@iconify-json/vscode-icons": "^1.2.83",
    "@iconify/utils": "^3.1.7",
    "@iconify/vue": "^5.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue/test-utils": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "cors": "^2.8.6",
    "diff": "^7.0.0",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.0",
    "electron": "^43.6.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "glob": "^13.0.6",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "lucide-vue-next": "^0.577.0",
    "marked": "^18.0.0",
    "mermaid": "^11.17.0",
    "openai": "^7.10.0",
    "pinia": "^4.0.0",
    "png-to-ico": "^3.0.2",
    "prism-react-renderer": "^2.4.1",
    "qrcode": "^1.5.4",
    "sass": "^1.104.0",
    "sass-embedded": "^1.104.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.11",
    "vue-i18n": "^9.14.4",
    "vue-tsc": "^3.3.11",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.spacecode.desktop",
    "productName": "SpaceCode",
    "icon": "icons",
    "publish": {
      "provider": "github",
      "owner": "hjdspace",
      "repo": "SpaceCode"
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@mariozechner/**/*",
      "!**/node_modules/**/*.map",
      "!**/node_modules/better-sqlite3/deps/**/*",
      "!**/node_modules/better-sqlite3/prebuilds/win32-arm64*",
      "!**/node_modules/better-sqlite3/prebuilds/linuxmusl-*",
      "!**/node_modules/better-sqlite3/src/**/*",
      "!**/node_modules/better-sqlite3/build/**/*",
      "!**/node_modules/node-pty/prebuilds/darwin-*",
      "!**/node_modules/node-pty/prebuilds/linux-*",
      "!**/node_modules/node-pty/prebuilds/win32-arm64*",
      "!**/node_modules/node-pty/prebuilds/**/*.pdb",
      "!**/node_modules/node-pty/src/**/*",
      "!**/node_modules/node-pty/deps/**/*",
      "!**/node_modules/node-pty/third_party/conpty/**/win10-arm64/**/*",
      "!**/node_modules/@mariozechner/pi-coding-agent/docs/**/*",
      "!**/node_modules/@mariozechner/pi-coding-agent/examples/**/*",
      "!**/node_modules/@mariozechner/pi-ai/node_modules/**/*",
      "!**/node_modules/koffi/build/koffi/darwin_*",
      "!**/node_modules/koffi/build/koffi/freebsd_*",
      "!**/node_modules/koffi/build/koffi/openbsd_*",
      "!**/node_modules/koffi/build/koffi/musl_*",
      "!**/node_modules/koffi/build/koffi/linux_*",
      "!**/node_modules/koffi/build/koffi/win32_ia32",
      "!**/node_modules/koffi/build/koffi/win32_arm64",
      "!**/node_modules/koffi/doc/**/*",
      "!**/node_modules/koffi/vendor/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@mariozechner/**/*",
      "dist-electron/proxy/**/*"
    ],
    "extraResources": [
      {
        "from": "icons",
        "to": "icons",
        "filter": [
          "*.png",
          "*.ico",
          "*.icns"
        ]
      },
      {
        "from": "engine/bin",
        "to": "engine/bin"
      },
      {
        "from": "engine/dist-desktop",
        "to": "engine/dist-desktop"
      },
      {
        "from": "resources/skills-lib",
        "to": "skills-lib"
      },
      {
        "from": "resources/agents-lib",
        "to": "agents-lib"
      },
      {
        "from": "release-notes",
        "to": "release-notes"
      },
      {
        "from": "resources/builtin-hooks",
        "to": "builtin-hooks"
      },
      {
        "from": "resources/browser-use",
        "to": "browser-use",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/officecli",
        "to": "officecli",
        "filter": [
          "**/*",
          "!README.md",
          "!**/*.update.partial",
          "!**/*.old",
          "!**/*.tmp"
        ]
      },
      {
        "from": "resources/cua-driver",
        "to": "cua-driver",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/design-systems-lib",
        "to": "design-systems-lib"
      }
    ],
    "win": {
      "icon": "icons/icon.ico",
      "artifactName": "SpaceCode-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerLanguages": [
        "zh-CN",
        "en-US"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  }
}
